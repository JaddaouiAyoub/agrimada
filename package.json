{
  "name": "farmshare",
  "version": "1.0.0",
  "private": true,
  "description": "FarmShare — gestion financière d'une ferme partagée",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "users:invite": "tsx scripts/invite-users.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "~6.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.0.0",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "uuid": "~11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.4.0",
    "prisma": "~6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
