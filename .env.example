# Base PostgreSQL (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fermedb"
# Connexion directe utilisée par Prisma Migrate (identique en local, différente derrière un pooler)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/fermedb"

# Secret Auth.js — générer avec : npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=""
# Requis hors Vercel en production (derrière un reverse proxy de confiance)
AUTH_TRUST_HOST="true"

# URL publique de l'application (utilisée pour construire les liens d'activation)
APP_URL="http://localhost:3000"
